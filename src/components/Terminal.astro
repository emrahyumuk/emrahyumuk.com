---
// The homepage IS a terminal: a short boot sequence, then a live prompt,
// presented as a GNOME-style emulator window. The login banner is computed
// from the collection at build time, so it stays true the day new posts land.
import { PS1 } from "../scripts/terminal/content";
import { getPosts } from "../lib/posts";

const { all, recent, archived } = await getPosts();
const lastLabel = all[0].data.date
  .toLocaleDateString("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "Europe/Istanbul",
  })
  .replaceAll(",", "");
---

<main class="term-window">
  <div class="term-titlebar">
    <span class="wm-spacer" aria-hidden="true"></span>
    <span class="term-title" aria-hidden="true">emrahyumuk@web: ~</span>
    <span class="wm-controls">
      <button id="wm-close" class="wm-close" aria-label="close the window"
        >×</button
      >
    </span>
  </div>

  <div
    class="term term-screen"
    id="term"
    data-last-label={lastLabel}
    data-last-iso={all[0].data.date.toISOString()}
    data-new-count={recent.length}
    data-archived-count={archived.length}
  >
    {
      /* role/aria-live are attached after the boot animation so screen readers
        don't re-announce every simulated keystroke */
    }
    <div id="term-out"></div>
    <form id="term-form" class="prompt-row" autocomplete="off">
      <label class="ps1" for="term-in" aria-hidden="true"
        ><Fragment set:html={PS1} /></label
      >
      <input
        id="term-in"
        class="prompt-input"
        type="text"
        aria-label="terminal command"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        disabled
      />
    </form>
    <noscript>
      <p class="noscript-nav">
        <a href="/blog/">blog</a> · <a href="/about/">about</a>
      </p>
    </noscript>
  </div>

  {
    /* fake vim, for the ones who type it. exit: :q! twice. It takes focus when
       it hides the screen (createVimTrap makes the root focusable), and the
       bottom line is role=status so the way out is announced, not just drawn */
  }
  <div id="vim" class="term-screen" aria-label="vim (not the real one)" hidden>
    <pre id="vim-buffer"></pre>
    <div id="vim-status" role="status"></div>
  </div>

  <div class="term-status mono">
    <span class="status-left">~</span>
    <span class="status-right">
      <span id="theme-name"></span>
      <button id="term-theme" aria-label="next colorscheme">◐</button>
    </span>
  </div>
</main>

{
  /* closing the GUI drops you to a bare virtual console; logging in brings it back */
}
<div id="tty" class="tty-console" hidden>
  <pre
    class="tty-banner">Fedora Linux 44 (Workstation Edition)
Kernel 6.16.2-300.fc44.x86_64 on an x86_64 (tty2)
</pre>
  <div id="tty-log"></div>
  <form id="tty-form" class="prompt-row">
    <label id="tty-label" for="tty-in">web login:</label>
    <input
      id="tty-in"
      class="prompt-input"
      type="text"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
    />
  </form>
</div>

<script>
  import { createTerminal } from "../scripts/terminal/boot";

  const byId = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  const screen = byId("term");
  const { lastLabel, lastIso, newCount, archivedCount } = screen.dataset;

  createTerminal(
    {
      window: document.querySelector<HTMLElement>(".term-window")!,
      screen,
      output: byId("term-out"),
      input: byId<HTMLInputElement>("term-in"),
      form: byId<HTMLFormElement>("term-form"),
      themeName: byId("theme-name"),
      themeButton: byId("term-theme"),
      closeButton: byId("wm-close"),
      vim: {
        root: byId("vim"),
        buffer: byId<HTMLPreElement>("vim-buffer"),
        status: byId("vim-status"),
      },
      tty: {
        root: byId("tty"),
        log: byId("tty-log"),
        label: byId("tty-label"),
        input: byId<HTMLInputElement>("tty-in"),
        form: byId<HTMLFormElement>("tty-form"),
      },
    },
    {
      lastLabel: lastLabel!,
      lastIso: lastIso!,
      newCount: Number(newCount),
      archivedCount: Number(archivedCount),
    },
  ).boot();
</script>

<style>
  /* window chrome, screen typography, prompt rows and text roles live in
     global.css (shared with the 404 page). only shell internals live here. */
  .term {
    overflow-y: auto;
    cursor: text;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  #term-theme {
    background: none;
    border: none;
    padding: 0;
    color: var(--muted);
    font: inherit;
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
  }
  #term-theme:hover {
    color: var(--accent-bright);
  }

  .term :global(.tline) {
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }
  /* ASCII art has to keep its columns; on a phone that means its own size */
  @media (max-width: 40rem) {
    .term :global(.art) {
      font-size: 0.75rem;
    }
  }
  .term :global(.caret),
  #term-form::after,
  #tty-form::after {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    vertical-align: text-bottom;
    background: var(--fg);
    animation: blink 1.1s steps(1) infinite;
  }

  /* the caret is drawn after the input so it can render as a block; the row
     centres it on the line, which is where a character's cell sits */
  #term-form::after,
  #tty-form::after {
    content: "";
    margin-left: calc(-0.4em - 2px); /* the row's gap, less the input's slack */
  }
  #term-form:focus-within::after {
    background: var(--green);
    box-shadow: 0 0 10px color-mix(in oklab, var(--green) 55%, transparent);
  }
  .ps1 {
    white-space: nowrap;
  }
  /* both inputs are sized to their content so the caret drawn after them lands
     right past the text. --cols is the character count, kept in sync by the
     shell; a monospace `ch` is exactly one advance, and the 2px is room for the
     native caret we hid — at an exact fit WebKit scrolls the text leftwards to
     keep that caret in view and clips the first character. (field-sizing would
     size these without script, but Safari shipped it far too late to rely on.) */
  #term-in,
  #tty-in {
    flex: 0 1 auto;
    width: calc(var(--cols, 0) * 1ch + 2px);
    min-width: 1px;
    caret-color: transparent; /* the ::after caret replaces it */
  }
  #term-in:disabled {
    opacity: 0;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .noscript-nav {
    margin-top: 1rem;
  }

  /* author display rules would defeat the hidden attribute — make it explicit */
  .tty-console[hidden],
  .term[hidden],
  #term-form[hidden],
  #vim[hidden] {
    display: none;
  }

  /* the sl locomotive, crossing the window right to left */
  .term :global(.sl-train),
  .term-window :global(.sl-train) {
    position: absolute;
    top: 28%;
    left: 100%;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.25;
    color: var(--fg);
    pointer-events: none;
    z-index: 5;
    white-space: pre;
  }

  #vim {
    overflow: hidden;
    color: var(--fg);
  }
  #vim-buffer,
  #vim-status {
    font: inherit;
    margin: 0;
    white-space: pre-wrap;
  }

  /* the bare virtual console behind the GUI: always dark, no window chrome */
  .tty-console {
    position: fixed;
    inset: 0;
    z-index: 10;
    background: #050505;
    color: #cfcfcf;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    padding: clamp(1rem, 4vw, 3rem);
    cursor: text;
  }
  /* same 16px floor as the emulator screen: the login prompt is an input too */
  @media (max-width: 40rem) {
    .tty-console {
      font-size: 1rem;
    }
  }
  .tty-banner {
    font: inherit;
    margin-bottom: 0.5rem;
    white-space: pre-wrap;
  }
  #tty-in {
    color: inherit; /* the console's own grey, not the theme foreground */
  }
  /* a real console echoes nothing at all while a password is typed, and the
     caret stays put — which also spares us guessing how wide a bullet is */
  #tty-in[type="password"] {
    width: 2px;
    color: transparent;
  }
  #tty-form::after {
    /* the console keeps a plain line, like the caret it used to borrow from the
       browser — but drawn by us, so it stays on the line on iOS too */
    width: 2px;
    margin-left: calc(-0.55em - 2px); /* at the end of the text, not past it */
    background: currentColor; /* grey with the console, not the theme's fg */
  }
</style>
